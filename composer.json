{
    "name": "cleatsquad/php-error-boundary",
    "description": "Deterministic fatal error and uncaught exception boundary returning standard JSON envelopes",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "error-boundary",
        "fatal-error",
        "json-error",
        "shutdown-handler",
        "exception-handler"
    ],
    "homepage": "https://github.com/CleatSquad/php-error-boundary",
    "readme": "README.md",
    "authors": [
        {
            "name": "Mohamed El Mrabet",
            "email": "mimou78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/CleatSquad/php-error-boundary/issues",
        "source": "https://github.com/CleatSquad/php-error-boundary"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\ErrorBoundary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\ErrorBoundary\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
